@page "/playlist"
@using MediatR
@using ThanhCaV2.Application.Hymns
@using ThanhCaV2.Application.Playlist
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject ThanhCaV2.Blazor.Services.ToastService ToastService
@rendermode InteractiveServer

<PageTitle>Danh sách trình chiếu buổi lễ</PageTitle>

<div class="container mx-auto p-4 max-w-5xl">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
        <div class="flex items-center">
            <button class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white mr-4 transition-all" @onclick='() => Navigation.NavigateTo("/hymns")'>
                <i class="bi bi-arrow-left"></i>
            </button>
            <h1 class="text-3xl font-extrabold tracking-tight text-white">Danh sách đã chọn</h1>
        </div>
        <button class="inline-flex items-center px-4 py-2 bg-rose-600 hover:bg-rose-500 disabled:opacity-30 disabled:cursor-not-allowed text-white text-sm font-bold rounded-xl shadow-lg shadow-rose-500/20 transition-all active:scale-95" 
                @onclick="ClearPlaylist" disabled="@(playlist == null || !playlist.Any())">
            <i class="bi bi-trash-fill mr-2"></i> Xóa toàn bộ
        </button>
    </div>

    @if (playlist == null)
    {
        <div class="flex flex-col items-center justify-center py-20">
            <div class="w-12 h-12 border-4 border-indigo-500/30 border-t-indigo-500 rounded-full animate-spin"></div>
        </div>
    }
    else if (!playlist.Any())
    {
        <div class="bg-slate-800/40 backdrop-blur-xl border border-white/5 border-dashed rounded-3xl py-20 text-center px-6">
            <div class="w-24 h-24 bg-slate-900/50 rounded-full flex items-center justify-center mx-auto mb-6 border border-white/5">
                <i class="bi bi-music-note-beamed text-5xl text-slate-500"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Chưa có bài hát nào được chọn</h3>
            <p class="text-slate-400 mb-8 max-w-md mx-auto">Hãy quay lại danh sách bài hát và thêm những bài bạn muốn trình chiếu trong buổi lễ.</p>
            <button class="inline-flex items-center px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl shadow-xl shadow-indigo-500/25 transition-all active:scale-95" @onclick='() => Navigation.NavigateTo("/hymns")'>
                Thêm bài hát mới vào danh sách
            </button>
        </div>
    }
    else
    {
        <div class="bg-slate-800/50 backdrop-blur-xl border border-white/10 rounded-3xl overflow-hidden shadow-2xl">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-900/50 border-b border-white/5">
                            <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest w-16">#</th>
                            <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest">Tên bài hát</th>
                            <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest">Tác giả</th>
                            <th class="px-6 py-4 text-slate-400 text-xs font-bold uppercase tracking-widest text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                        @foreach (var item in playlist)
                        {
                            <tr class="group hover:bg-white/5 transition-colors">
                                <td class="px-6 py-5 text-slate-500 font-medium">@item.Order</td>
                                <td class="px-6 py-5">
                                    <span class="text-lg font-bold text-white group-hover:text-indigo-400 transition-colors">@item.Title</span>
                                </td>
                                <td class="px-6 py-5">
                                    <span class="text-slate-400">@item.Author</span>
                                </td>
                                <td class="px-6 py-5">
                                    <div class="flex justify-center gap-3">
                                        <button class="flex items-center gap-2 px-4 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold rounded-xl shadow-lg shadow-indigo-500/20 transition-all active:scale-95" @onclick='() => Navigation.NavigateTo($"/project/{item.HymnId}")'>
                                            <i class="bi bi-play-fill text-lg"></i> Chiếu
                                        </button>
                                        <button class="w-9 h-9 flex items-center justify-center rounded-xl bg-rose-500/10 text-rose-500 border border-rose-500/20 hover:bg-rose-500 hover:text-white transition-all" @onclick="() => RemoveFromPlaylist(item.Id)" title="Xóa khỏi danh sách này">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<PlaylistDto>? playlist;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlaylist();
    }

    private async Task LoadPlaylist()
    {
        playlist = await Mediator.Send(new GetPlaylistQuery());
    }

    private async Task RemoveFromPlaylist(Guid id)
    {
        await Mediator.Send(new RemoveFromPlaylistCommand(id));
        ToastService.ShowInfo("Đã xóa khỏi danh sách lễ");
        await LoadPlaylist();
    }

    private async Task ClearPlaylist()
    {
        await Mediator.Send(new ClearPlaylistCommand());
        ToastService.ShowSuccess("Đã dọn dẹp danh sách lễ");
        await LoadPlaylist();
    }
}
