@using ThanhCaV2.Blazor.Services
@implements IDisposable
@inject ToastService ToastService

<div class="fixed bottom-6 right-6 z-[9999] flex flex-col gap-3 pointer-events-none min-w-[320px] max-w-md">
    @foreach (var toast in ToastService.GetToasts())
    {
        <div class="pointer-events-auto animate-toast-in">
            <div class="flex items-center p-4 rounded-2xl border shadow-2xl backdrop-blur-xl @GetToastStyles(toast.Type)">
                <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-xl mr-4 @GetIconBackgroundStyles(toast.Type)">
                    <i class="bi @GetIconStyles(toast.Type) text-lg"></i>
                </div>
                <div class="flex-1 mr-4">
                    <p class="text-sm font-bold text-white">@toast.Message</p>
                </div>
                <button @onclick="() => ToastService.RemoveToast(toast.Id)" class="text-white/40 hover:text-white transition-colors">
                    <i class="bi bi-x-lg text-xs"></i>
                </button>
            </div>
        </div>
    }
</div>

<style>
    @@keyframes toast-in {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    .animate-toast-in {
        animation: toast-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ToastService.OnChange -= StateHasChanged;
    }

    private string GetToastStyles(ToastType type) => type switch
    {
        ToastType.Success => "bg-emerald-500/10 border-emerald-500/20 shadow-emerald-500/10",
        ToastType.Error => "bg-rose-500/10 border-rose-500/20 shadow-rose-500/10",
        ToastType.Warning => "bg-amber-500/10 border-amber-500/20 shadow-amber-500/10",
        _ => "bg-indigo-500/10 border-indigo-500/20 shadow-indigo-500/10"
    };

    private string GetIconBackgroundStyles(ToastType type) => type switch
    {
        ToastType.Success => "bg-emerald-500 text-white",
        ToastType.Error => "bg-rose-500 text-white",
        ToastType.Warning => "bg-amber-500 text-white",
        _ => "bg-indigo-500 text-white"
    };

    private string GetIconStyles(ToastType type) => type switch
    {
        ToastType.Success => "bi-check-circle-fill",
        ToastType.Error => "bi-exclamation-octagon-fill",
        ToastType.Warning => "bi-exclamation-triangle-fill",
        _ => "bi-info-circle-fill"
    };
}
